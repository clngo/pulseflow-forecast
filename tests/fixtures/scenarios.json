{
  "clean": {
    "expected_outcome": "correct",
    "description": "Valid baseline with one strategic deal, one Salesforce longtail deal, and one CareBridge deal.",
    "operations": []
  },
  "carebridge_annual": {
    "expected_outcome": "correct",
    "description": "A CareBridge annual amount is used without annualization.",
    "operations": [
      {"action": "set", "dataset": "carebridge", "match": {"HubSpot_Deal_ID": "HS-CLEAN-1"}, "values": {"Amount": "120000", "Billing_Frequency": "Annual"}}
    ]
  },
  "exact_duplicate": {
    "expected_outcome": "correct",
    "description": "An exact Salesforce copy is collapsed and audited.",
    "operations": [
      {"action": "copy_row", "dataset": "current", "match": {"Opportunity_ID": "006TEST00000002AAA"}}
    ]
  },
  "scorecard_probability_mismatch": {
    "expected_outcome": "correct",
    "description": "The workbook probability differs from the deterministic GPA rule.",
    "operations": [
      {"action": "set", "dataset": "scorecard", "match": {"Opportunity_ID_15": "006TEST00000001"}, "values": {"Win_Probability": 0.5}}
    ]
  },
  "closed_lost_salesforce": {
    "expected_outcome": "correct",
    "description": "A Salesforce Closed Lost record carries a nonzero source probability that must become zero.",
    "operations": [
      {"action": "copy_row", "dataset": "current", "match": {"Opportunity_ID": "006TEST00000002AAA"}, "values": {"Opportunity_ID": "006TEST00000003AAA", "Health_System": "Closed Lost Health", "Stage": "Closed Lost", "Stage_Probability": "0.40"}},
      {"action": "copy_row", "dataset": "prior", "match": {"Opportunity_ID": "006TEST00000002AAA"}, "values": {"Opportunity_ID": "006TEST00000003AAA", "Health_System": "Closed Lost Health", "Stage": "Technical Validation", "Stage_Probability": "0.40"}}
    ]
  },
  "closed_lost_carebridge": {
    "expected_outcome": "correct",
    "description": "A CareBridge Closed Lost record carries a nonzero source probability that must become zero.",
    "operations": [
      {"action": "copy_row", "dataset": "carebridge", "match": {"HubSpot_Deal_ID": "HS-CLEAN-1"}, "values": {"HubSpot_Deal_ID": "HS-CLOSED-1", "Company_Name": "Closed CareBridge Deal", "Deal_Stage": "Closed Lost", "Stage_Probability": "0.30", "Amount": "120000", "Billing_Frequency": "Annual"}}
    ]
  },
  "equivalent_cross_source": {
    "expected_outcome": "correct",
    "description": "Equivalent Salesforce and CareBridge records are counted once.",
    "operations": [
      {"action": "copy_row", "dataset": "current", "match": {"Opportunity_ID": "006TEST00000002AAA"}, "values": {"Opportunity_ID": "006TEST00000004AAA", "Health_System": "Shared Post-Acute Care", "Product": "CareBridge", "Stage": "Contract Negotiations", "Stage_Probability": "0.80", "Amount": "180000", "Close_Date": "2026-12-01", "Sales_Rep": "Shared Owner"}},
      {"action": "set", "dataset": "carebridge", "match": {"HubSpot_Deal_ID": "HS-CLEAN-1"}, "values": {"Company_Name": "Shared Post-Acute Care", "AE_Owner": "Shared Owner", "Amount": "15000", "Billing_Frequency": "Monthly", "Expected_Close_Date": "2026-12-01"}}
    ]
  },
  "two_conflicting_duplicates": {
    "expected_outcome": "correct",
    "description": "Two financially conflicting but identity-consistent rows remain forecast variants.",
    "operations": [
      {"action": "copy_row", "dataset": "current", "match": {"Opportunity_ID": "006TEST00000002AAA"}, "values": {"Stage": "Contract Negotiations", "Stage_Probability": "0.80", "Amount": "200000"}}
    ]
  },
  "mixed_exact_and_conflicting_duplicates": {
    "expected_outcome": "correct",
    "description": "Exact copies do not increase the number of distinct conflicting variants.",
    "operations": [
      {"action": "copy_row", "dataset": "current", "match": {"Opportunity_ID": "006TEST00000002AAA"}},
      {"action": "copy_row", "dataset": "current", "match": {"Opportunity_ID": "006TEST00000002AAA"}, "values": {"Amount": "200000", "Stage": "Contract Negotiations", "Stage_Probability": "0.80"}},
      {"action": "copy_row", "dataset": "current", "match": {"Opportunity_ID": "006TEST00000002AAA"}, "values": {"Amount": "300000", "Stage": "Technical Validation", "Stage_Probability": "0.40"}}
    ]
  },
  "duplicate_identity_disagreement": {
    "expected_outcome": "human_review",
