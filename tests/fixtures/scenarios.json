      {"action": "set", "dataset": "carebridge", "match": {"HubSpot_Deal_ID": "HS-CLEAN-1"}, "values": {"Company_Name": "Shared Post-Acute Care", "AE_Owner": "Shared Owner", "Amount": "240000", "Billing_Frequency": "Annual", "Expected_Close_Date": "2026-12-01"}}
