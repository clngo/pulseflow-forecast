      {"action": "copy_row", "dataset": "current", "match": {"Opportunity_ID": "006TEST00000002AAA"}, "values": {"Health_System": "Different Health System", "Amount": "200000"}}
    ]
  },
  "cross_source_value_conflict": {
    "expected_outcome": "human_review",
